---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, period, year, status, tags, repo, url } = project.data;
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="entry-meta">
        <span>{period ?? year}</span>
        <span class:list={['status', `status--${status}`]}>{status}</span>
        {repo && <a href={repo} rel="noopener">Source</a>}
        {url && <a href={url} rel="noopener">Live</a>}
      </p>
      {tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </header>
    <slot />
  </article>

  <hr />
  <p><a href="/projects">&larr; All projects</a></p>
</BaseLayout>
